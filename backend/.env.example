# ──── App ────
APP_NAME=StudyAssist
APP_VERSION=0.1.0
DEBUG=true

# ──── Server ────
HOST=0.0.0.0
PORT=8000

# ──── Database ────
DATABASE_URL=sqlite+aiosqlite:///./studyassist.db

# ──── Ollama ────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava
OLLAMA_TIMEOUT=120

# ──── File Uploads ────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# ──── CORS ────
# For development, allow all. In production, set specific origins.
# CORS_ORIGINS=["http://localhost:3000"]
